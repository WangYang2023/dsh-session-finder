{
  "name": "dsh-session-finder",
  "version": "0.6.0",
  "description": "DSH Web 插件：跨会话消息级全文检索 + 会话总览。检索到具体某条消息（正文/工具名/参数/错误摘要），总览浏览全部会话，只读上下文预览。（dsh-session-explorer 的维护分支，适配 DSH 0.2.x）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.zh.md",
    "screenshots.json"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.0.1-rc.3",
    "zod": "^4.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "pnpm build",
    "test": "tsx --test test/*.test.ts",
    "pack:check": "pnpm pack --dry-run",
    "install:desktop": "sh scripts/install-to-desktop.sh",
    "smoke:client": "node scripts/smoke-client.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.0.1-rc.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rolldown": "^1.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "zod": "^4.6.6"
  },
  "peerDependenciesMeta": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WangYang2023/dsh-session-finder.git"
  },
  "homepage": "https://github.com/WangYang2023/dsh-session-finder#readme",
  "bugs": {
    "url": "https://github.com/WangYang2023/dsh-session-finder/issues"
  }
}
